// Prisma Schema for Retail Inventory Management System
// Project ID: P_022
// Backend Database Foundation: MySQL + Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. ROLES & USERS
// ==========================================

enum RoleName {
  ADMIN
  INVENTORY_MANAGER
  WAREHOUSE_MANAGER
  PROCUREMENT_MANAGER
  SALES_MANAGER
  STAFF
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model Role {
  id          String   @id @default(cuid())
  name        RoleName @unique
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relationships
  users User[]

  @@map("roles")
}

model User {
  id           String     @id @default(cuid())
  name         String     @db.VarChar(100)
  email        String     @unique @db.VarChar(150)
  passwordHash String?    @map("password_hash") @db.VarChar(255) // Optional until auth sprint
  department   String?    @db.VarChar(100)
  status       UserStatus @default(ACTIVE)
  lastLogin    DateTime?  @map("last_login")
  roleId       String     @map("role_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  // Relationships
  role               Role            @relation(fields: [roleId], references: [id])
  managedWarehouses  Warehouse[]     @relation("WarehouseManager")
  createdPOs         PurchaseOrder[] @relation("POCreator")
  stockMovements     StockMovement[] @relation("MovementPerformer")
  requestedTransfers StockTransfer[] @relation("TransferRequester")
  approvedTransfers  StockTransfer[] @relation("TransferApprover")
  notifications      Notification[]
  auditLogs          AuditLog[]

  @@index([roleId])
  @@index([email])
  @@map("users")
}

// ==========================================
// 2. PRODUCT CATALOG & CATEGORIES
// ==========================================

enum CategoryStatus {
  ACTIVE
  INACTIVE
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

model Category {
  id          String         @id @default(cuid())
  name        String         @unique @db.VarChar(100)
  description String?        @db.Text
  status      CategoryStatus @default(ACTIVE)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  // Relationships
  products Product[]

  @@map("categories")
}

model Product {
  id           String        @id @default(cuid())
  sku          String        @unique @db.VarChar(50)
  name         String        @db.VarChar(200)
  description  String?       @db.Text
  brand        String?       @db.VarChar(100)
  categoryId   String        @map("category_id")
  costPrice    Decimal       @default(0.00) @map("cost_price") @db.Decimal(12, 2)
  sellingPrice Decimal       @default(0.00) @map("selling_price") @db.Decimal(12, 2)
  unit         String        @default("Pieces") @db.VarChar(30)
  reorderLevel Int           @default(10) @map("reorder_level")
  status       ProductStatus @default(ACTIVE)
  imageUrl     String?       @map("image_url") @db.VarChar(500)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  // Relationships
  category           Category             @relation(fields: [categoryId], references: [id])
  inventory          Inventory[]
  stockMovements     StockMovement[]
  supplierProducts   SupplierProduct[]
  purchaseOrderItems PurchaseOrderItem[]
  orderItems         OrderItem[]
  stockTransferItems StockTransferItem[]

  @@index([categoryId])
  @@index([sku])
  @@index([name])
  @@map("products")
}

// ==========================================
// 3. WAREHOUSES & REGIONAL HUBS
// ==========================================

enum WarehouseStatus {
  ACTIVE
  INACTIVE
  UNDER_MAINTENANCE
}

model Warehouse {
  id           String          @id @default(cuid())
  code         String          @unique @db.VarChar(50)
  name         String          @db.VarChar(150)
  address      String?         @db.VarChar(255)
  city         String?         @db.VarChar(100)
  state        String?         @db.VarChar(100)
  pincode      String?         @db.VarChar(20)
  capacity     Int             @default(0)
  status       WarehouseStatus @default(ACTIVE)
  staffCount   Int             @default(0) @map("staff_count")
  managerId    String?         @map("manager_id")
  managerName  String?         @map("manager_name") @db.VarChar(100)
  managerEmail String?         @map("manager_email") @db.VarChar(150)
  managerPhone String?         @map("manager_phone") @db.VarChar(50)
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  // Relationships
  manager             User?           @relation("WarehouseManager", fields: [managerId], references: [id], onDelete: SetNull)
  inventory           Inventory[]
  stockMovements      StockMovement[]
  purchaseOrders      PurchaseOrder[]
  orders              Order[]
  outgoingTransfers   StockTransfer[] @relation("SourceWarehouse")
  incomingTransfers   StockTransfer[] @relation("DestinationWarehouse")

  @@index([code])
  @@index([managerId])
  @@map("warehouses")
}

// ==========================================
// 4. INVENTORY & STOCK MOVEMENTS
// ==========================================

model Inventory {
  id            String   @id @default(cuid())
  productId     String   @map("product_id")
  warehouseId   String   @map("warehouse_id")
  currentStock  Int      @default(0) @map("current_stock")
  reservedStock Int      @default(0) @map("reserved_stock")
  reorderLevel  Int      @default(10) @map("reorder_level")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relationships
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse      Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  stockMovements StockMovement[]

  // Critical Constraint: One Product per Warehouse
  @@unique([productId, warehouseId], name: "unique_product_warehouse_inventory")
  @@index([warehouseId])
  @@index([productId])
  @@map("inventory")
}

enum MovementType {
  RECEIPT
  SALE
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
  RETURN
}

model StockMovement {
  id           String       @id @default(cuid())
  inventoryId  String       @map("inventory_id")
  productId    String       @map("product_id")
  warehouseId  String       @map("warehouse_id")
  type         MovementType
  quantity     Int          // Magnitude of stock change
  reference    String?      @db.VarChar(100) // e.g., PO number, Order number, Transfer number
  performedById String?     @map("performed_by_id")
  performedBy  String?      @map("performed_by") @db.VarChar(100) // Snapshot name / designation
  notes        String?      @db.Text
  createdAt    DateTime     @default(now()) @map("created_at")

  // Relationships
  inventory       Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  product         Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse       Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  performedByUser User?     @relation("MovementPerformer", fields: [performedById], references: [id], onDelete: SetNull)

  @@index([inventoryId])
  @@index([productId])
  @@index([warehouseId])
  @@index([type])
  @@index([reference])
  @@index([createdAt])
  @@map("stock_movements")
}

// ==========================================
// 5. SUPPLIERS & PROCUREMENT
// ==========================================

enum SupplierStatus {
  ACTIVE
  INACTIVE
}

model Supplier {
  id           String         @id @default(cuid())
  supplierCode String         @unique @map("supplier_code") @db.VarChar(50)
  name         String         @db.VarChar(150)
  companyName  String?        @map("company_name") @db.VarChar(200)
  category     String?        @db.VarChar(100)
  contactPerson String?       @map("contact_person") @db.VarChar(100)
  email        String?        @db.VarChar(150)
  phone        String?        @db.VarChar(50)
  address      String?        @db.VarChar(255)
  city         String?        @db.VarChar(100)
  state        String?        @db.VarChar(100)
  pincode      String?        @db.VarChar(20)
  gstNumber    String?        @map("gst_number") @db.VarChar(50)
  paymentTerms String?        @default("Net 30") @map("payment_terms") @db.VarChar(50)
  status       SupplierStatus @default(ACTIVE)
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  // Relationships
  supplierProducts SupplierProduct[]
  purchaseOrders   PurchaseOrder[]

  @@index([supplierCode])
  @@map("suppliers")
}

model SupplierProduct {
  id           String   @id @default(cuid())
  supplierId   String   @map("supplier_id")
  productId    String   @map("product_id")
  supplierSku  String?  @map("supplier_sku") @db.VarChar(100)
  costPrice    Decimal? @map("cost_price") @db.Decimal(12, 2)
  leadTimeDays Int?     @default(7) @map("lead_time_days")
  isPrimary    Boolean  @default(false) @map("is_primary")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relationships
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Enforce unique vendor per product allocation
  @@unique([supplierId, productId], name: "unique_supplier_product")
  @@index([productId])
  @@index([supplierId])
  @@map("supplier_products")
}

enum PurchaseOrderStatus {
  DRAFT
  PENDING
  APPROVED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id           String              @id @default(cuid())
  poNumber     String              @unique @map("po_number") @db.VarChar(50)
  supplierId   String              @map("supplier_id")
  warehouseId  String              @map("warehouse_id")
  orderDate    DateTime            @default(now()) @map("order_date")
  expectedDate DateTime?           @map("expected_date")
  status       PurchaseOrderStatus @default(DRAFT)
  subtotal     Decimal             @default(0.00) @db.Decimal(12, 2)
  tax          Decimal             @default(0.00) @db.Decimal(12, 2)
  total        Decimal             @default(0.00) @db.Decimal(12, 2)
  createdById  String?             @map("created_by_id")
  createdBy    String?             @map("created_by") @db.VarChar(100) // Snapshot creator name
  notes        String?             @db.Text
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  // Relationships
  supplier      Supplier            @relation(fields: [supplierId], references: [id])
  warehouse     Warehouse           @relation(fields: [warehouseId], references: [id])
  createdByUser User?               @relation("POCreator", fields: [createdById], references: [id], onDelete: SetNull)
  items         PurchaseOrderItem[]

  @@index([poNumber])
  @@index([supplierId])
  @@index([warehouseId])
  @@index([status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String   @id @default(cuid())
  purchaseOrderId  String   @map("purchase_order_id")
  productId        String   @map("product_id")
  quantity         Int
  receivedQuantity Int      @default(0) @map("received_quantity")
  unitPrice        Decimal  @map("unit_price") @db.Decimal(12, 2)
  tax              Decimal  @default(0.00) @db.Decimal(12, 2)
  lineTotal        Decimal  @map("line_total") @db.Decimal(12, 2)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  // Relationships
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id])

  @@index([purchaseOrderId])
  @@index([productId])
  @@map("purchase_order_items")
}

// ==========================================
// 6. CUSTOMER ORDERS & FULFILLMENT
// ==========================================

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  PICKING
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Order {
  id                 String        @id @default(cuid())
  orderNumber        String        @unique @map("order_number") @db.VarChar(50)
  customerName       String        @map("customer_name") @db.VarChar(150)
  customerEmail      String?       @map("customer_email") @db.VarChar(150)
  customerPhone      String?       @map("customer_phone") @db.VarChar(50)
  shippingAddress    String?       @map("shipping_address") @db.VarChar(255)
  shippingCity       String?       @map("shipping_city") @db.VarChar(100)
  shippingState      String?       @map("shipping_state") @db.VarChar(100)
  shippingPincode    String?       @map("shipping_pincode") @db.VarChar(20)
  orderDate          DateTime      @default(now()) @map("order_date")
  status             OrderStatus   @default(PENDING)
  paymentStatus      PaymentStatus @default(PENDING) @map("payment_status")
  warehouseId        String        @map("warehouse_id")
  subtotal           Decimal       @default(0.00) @db.Decimal(12, 2)
  tax                Decimal       @default(0.00) @db.Decimal(12, 2)
  shipping           Decimal       @default(0.00) @db.Decimal(12, 2)
  totalAmount        Decimal       @default(0.00) @map("total_amount") @db.Decimal(12, 2)
  cancellationReason String?       @map("cancellation_reason") @db.VarChar(255)
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  // Relationships
  warehouse Warehouse   @relation(fields: [warehouseId], references: [id])
  items     OrderItem[]

  @@index([orderNumber])
  @@index([warehouseId])
  @@index([status])
  @@index([paymentStatus])
  @@map("orders")
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String   @map("order_id")
  productId String   @map("product_id")
  quantity  Int
  unitPrice Decimal  @map("unit_price") @db.Decimal(12, 2)
  total     Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relationships
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// ==========================================
// 7. WAREHOUSE STOCK TRANSFERS
// ==========================================

enum TransferStatus {
  PENDING
  APPROVED
  IN_TRANSIT
  RECEIVED
  CANCELLED
}

model StockTransfer {
  id                     String         @id @default(cuid())
  transferNumber         String         @unique @map("transfer_number") @db.VarChar(50)
  sourceWarehouseId      String         @map("source_warehouse_id")
  destinationWarehouseId String         @map("destination_warehouse_id")
  status                 TransferStatus @default(PENDING)
  requestedById          String?        @map("requested_by_id")
  requestedBy            String?        @map("requested_by") @db.VarChar(100)
  approvedById           String?        @map("approved_by_id")
  approvedBy             String?        @map("approved_by") @db.VarChar(100)
  notes                  String?        @db.Text
  shippedAt              DateTime?      @map("shipped_at")
  receivedAt             DateTime?      @map("received_at")
  createdAt              DateTime       @default(now()) @map("created_at")
  updatedAt              DateTime       @updatedAt @map("updated_at")

  // Relationships
  sourceWarehouse      Warehouse           @relation("SourceWarehouse", fields: [sourceWarehouseId], references: [id])
  destinationWarehouse Warehouse           @relation("DestinationWarehouse", fields: [destinationWarehouseId], references: [id])
  requestedByUser      User?               @relation("TransferRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  approvedByUser       User?               @relation("TransferApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  items                StockTransferItem[]

  @@index([transferNumber])
  @@index([sourceWarehouseId])
  @@index([destinationWarehouseId])
  @@index([status])
  @@map("stock_transfers")
}

model StockTransferItem {
  id               String   @id @default(cuid())
  transferId       String   @map("transfer_id")
  productId        String   @map("product_id")
  quantity         Int
  receivedQuantity Int      @default(0) @map("received_quantity")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  // Relationships
  stockTransfer StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id])

  @@index([transferId])
  @@index([productId])
  @@map("stock_transfer_items")
}

// ==========================================
// 8. NOTIFICATIONS
// ==========================================

enum NotificationType {
  LOW_STOCK
  OUT_OF_STOCK
  PURCHASE_ORDER
  ORDER
  WAREHOUSE
  SYSTEM
}

enum NotificationSeverity {
  INFO
  WARNING
  CRITICAL
  SUCCESS
}

model Notification {
  id        String               @id @default(cuid())
  userId    String?              @map("user_id")
  type      NotificationType
  title     String               @db.VarChar(200)
  message   String               @db.Text
  read      Boolean              @default(false)
  severity  NotificationSeverity @default(INFO)
  relatedId String?              @map("related_id") @db.VarChar(255) // Optional routing target
  createdAt DateTime             @default(now()) @map("created_at")

  // Relationships
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@index([severity])
  @@index([createdAt])
  @@map("notifications")
}

// ==========================================
// 9. AUDIT LOGS
// ==========================================

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  STATUS_CHANGE
  STOCK_ADJUSTMENT
  APPROVAL
  LOGIN
}

enum AuditModule {
  PRODUCT
  WAREHOUSE
  INVENTORY
  SUPPLIER
  PURCHASE_ORDER
  ORDER
  USER
  SYSTEM
}

enum AuditSeverity {
  INFO
  WARNING
  CRITICAL
  SUCCESS
}

model AuditLog {
  id          String        @id @default(cuid())
  userId      String?       @map("user_id")
  userName    String?       @map("user_name") @db.VarChar(100)
  userRole    String?       @map("user_role") @db.VarChar(50)
  action      AuditAction
  module      AuditModule
  entity      String        @db.VarChar(100)
  entityId    String        @map("entity_id") @db.VarChar(100)
  description String        @db.Text
  severity    AuditSeverity @default(INFO)
  ipAddress   String?       @map("ip_address") @db.VarChar(50)
  createdAt   DateTime      @default(now()) @map("created_at")

  // Relationships
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([module])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}
